; Engine configuration file.
; Slovo Patsana — Godot 4.4 port.
config_version=5

[application]

config/name="Слово пацана: Улицы Казани"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.024, 0.04, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://src/core/Game.gd"

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[gui]

theme/custom="res://assets/theme.tres"
theme/default_font_antialiasing=1

[input]

move_forward={"deadzone":0.2,"events":[{"type":"key","keycode":87},{"type":"joy_axis","axis":1,"axis_value":-1.0}]}
move_back={"deadzone":0.2,"events":[{"type":"key","keycode":83},{"type":"joy_axis","axis":1,"axis_value":1.0}]}
move_left={"deadzone":0.2,"events":[{"type":"key","keycode":65},{"type":"joy_axis","axis":0,"axis_value":-1.0}]}
move_right={"deadzone":0.2,"events":[{"type":"key","keycode":68},{"type":"joy_axis","axis":0,"axis_value":1.0}]}
run={"deadzone":0.5,"events":[{"type":"key","keycode":4194325},{"type":"joy_button","button_index":10},{"type":"joy_axis","axis":5,"axis_value":1.0}]}
punch={"deadzone":0.5,"events":[{"type":"key","keycode":74},{"type":"mouse_button","button_index":1},{"type":"joy_button","button_index":2}]}
kick={"deadzone":0.5,"events":[{"type":"key","keycode":75},{"type":"mouse_button","button_index":2},{"type":"joy_button","button_index":3}]}
block={"deadzone":0.5,"events":[{"type":"key","keycode":81},{"type":"key","keycode":76},{"type":"joy_button","button_index":9},{"type":"joy_axis","axis":4,"axis_value":1.0}]}
special={"deadzone":0.5,"events":[{"type":"key","keycode":69},{"type":"key","keycode":85},{"type":"joy_button","button_index":1}]}
dodge={"deadzone":0.5,"events":[{"type":"key","keycode":32},{"type":"joy_button","button_index":0}]}
interact={"deadzone":0.5,"events":[{"type":"key","keycode":70},{"type":"joy_button","button_index":10}]}
cam_left={"deadzone":0.5,"events":[{"type":"key","keycode":90}]}
cam_right={"deadzone":0.5,"events":[{"type":"key","keycode":67}]}
pause={"deadzone":0.5,"events":[{"type":"key","keycode":4194305},{"type":"joy_button","button_index":6}]}
help={"deadzone":0.5,"events":[{"type":"key","keycode":72}]}
ui_confirm={"deadzone":0.5,"events":[{"type":"key","keycode":4194309},{"type":"key","keycode":4194310},{"type":"key","keycode":74},{"type":"joy_button","button_index":0}]}
p2_forward={"deadzone":0.2,"events":[{"type":"key","keycode":4194320}]}
p2_back={"deadzone":0.2,"events":[{"type":"key","keycode":4194322}]}
p2_left={"deadzone":0.2,"events":[{"type":"key","keycode":4194319}]}
p2_right={"deadzone":0.2,"events":[{"type":"key","keycode":4194321}]}
p2_run={"deadzone":0.5,"events":[{"type":"key","keycode":4194326}]}
p2_punch={"deadzone":0.5,"events":[{"type":"key","keycode":4194433},{"type":"key","keycode":44}]}
p2_kick={"deadzone":0.5,"events":[{"type":"key","keycode":4194434},{"type":"key","keycode":46}]}
p2_block={"deadzone":0.5,"events":[{"type":"key","keycode":4194435},{"type":"key","keycode":47}]}
p2_special={"deadzone":0.5,"events":[{"type":"key","keycode":4194436},{"type":"key","keycode":59}]}
p2_dodge={"deadzone":0.5,"events":[{"type":"key","keycode":4194438},{"type":"key","keycode":39}]}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="people"
3d_physics/layer_3="cars"
3d_physics/layer_4="pickups"

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.02, 0.024, 0.04, 1)
textures/default_filters/anisotropic_filtering_level=3

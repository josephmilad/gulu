class_name Controls
## The controls table, keyboard or touch.

static func text() -> String:
	if Game.touch:
		return "\n".join([
			"Ходить — левый палец, джойстик появляется там, где коснёшься",
			"Бег — джойстик до упора",
			"Камера — веди правым пальцем по экрану",
			"Удар рукой (серия) — РУКА, жми несколько раз",
			"Удар ногой — НОГА · Блок — БЛОК (держать)",
			"Спецприём — ПРИЁМ (нужна жёлтая полоса) · Уклон — УКЛОН",
			"Машина — МАШИНА у двери водителя; за рулём джойстик — газ и руль, УКЛОН — ручник",
			"Пауза — II вверху",
		])
	return "\n".join([
		"Ходить — W A S D · Бег — Shift",
		"Камера — мышь (кликни по экрану) · Z / C",
		"Удар рукой (серия) — ЛКМ или J, жми несколько раз",
		"Удар ногой — ПКМ или K · Блок — Q или L (держать)",
		"Спецприём — E или U (нужна жёлтая полоса) · Уклон — Пробел",
		"Сесть / выйти из машины — F (у двери водителя)",
		"За рулём — W/S газ и тормоз · A/D руль · Пробел ручник",
		"Пауза — Esc · Геймпад: стик — ходить, X — рука, Y — нога, B — приём, A — уклон, LB — блок",
	])
